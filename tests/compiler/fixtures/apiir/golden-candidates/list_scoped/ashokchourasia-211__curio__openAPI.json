{
  "apiIrVersion": 1,
  "api": {
    "title": "Curio - Anonymous Classroom API",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Student",
      "key": "student",
      "operations": [
        {
          "id": "verifySession",
          "method": "GET",
          "kind": "detail",
          "path": "/sessions/verify/{code}",
          "parameters": [
            {
              "in": "path",
              "name": "code",
              "schema": {
                "type": "string",
                "example": "PHY-88"
              }
            }
          ],
          "identifierParam": "code",
          "responseSchema": {
            "type": "object",
            "properties": {
              "valid": {
                "type": "boolean",
                "example": true
              },
              "session_id": {
                "type": "string",
                "format": "uuid"
              },
              "subject": {
                "type": "string",
                "example": "Physics 101"
              }
            }
          }
        },
        {
          "id": "postQuestion",
          "method": "POST",
          "kind": "create",
          "path": "/questions",
          "parameters": [],
          "requestSchema": {
            "type": "object",
            "required": [
              "session_id",
              "text",
              "student_hash"
            ],
            "properties": {
              "session_id": {
                "type": "string",
                "format": "uuid"
              },
              "text": {
                "type": "string",
                "example": "Why does an apple fall down?"
              },
              "student_hash": {
                "type": "string",
                "description": "Anonymized fingerprint of the student",
                "example": "user_hash_xyz123"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "question_id": {
                "type": "string",
                "format": "uuid"
              },
              "text": {
                "type": "string",
                "example": "Why does an apple fall down?"
              },
              "student_name": {
                "type": "string",
                "description": "Randomly generated name",
                "example": "Anonymous Badger"
              },
              "ai_response": {
                "type": "string",
                "description": "The answer generated by Gemini 2.5 Flash",
                "example": "Gravity is a force that pulls objects toward the center of the Earth."
              },
              "status": {
                "type": "string",
                "enum": [
                  "posted",
                  "flagged"
                ],
                "example": "posted"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Teacher",
      "key": "teacher",
      "operations": [
        {
          "id": "getQuestions",
          "method": "GET",
          "kind": "listScoped",
          "path": "/questions/{session_id}",
          "parameters": [
            {
              "in": "path",
              "name": "session_id",
              "schema": {
                "type": "string",
                "format": "uuid"
              },
              "format": "uuid"
            },
            {
              "in": "query",
              "name": "last_seen_timestamp",
              "schema": {
                "type": "string",
                "format": "date-time"
              },
              "format": "date-time"
            }
          ],
          "identifierParam": "session_id",
          "queryParamCount": 1,
          "responseSchema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "text": {
                  "type": "string",
                  "example": "Why does an apple fall down?"
                },
                "student_name": {
                  "type": "string",
                  "description": "Randomly generated name",
                  "example": "Anonymous Badger"
                },
                "ai_response": {
                  "type": "string",
                  "description": "The answer generated by Gemini 2.5 Flash",
                  "example": "Gravity is a force that pulls objects toward the center of the Earth."
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "posted",
                    "flagged"
                  ],
                  "example": "posted"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        },
        {
          "id": "createSession",
          "method": "POST",
          "kind": "create",
          "path": "/sessions",
          "parameters": [],
          "requestSchema": {
            "type": "object",
            "required": [
              "teacher_id",
              "subject"
            ],
            "properties": {
              "teacher_id": {
                "type": "string",
                "example": "teacher_001"
              },
              "subject": {
                "type": "string",
                "example": "Physics 101"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "format": "uuid",
                "example": "123e4567-e89b-12d3-a456-426614174000"
              },
              "code": {
                "type": "string",
                "description": "Unique 6-char code",
                "example": "PHY-88"
              }
            }
          }
        }
      ]
    }
  ]
}