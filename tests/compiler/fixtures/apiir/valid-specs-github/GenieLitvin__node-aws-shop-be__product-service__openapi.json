              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                },
                "count": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "id": "GET:/products/{id}",
          "method": "GET",
