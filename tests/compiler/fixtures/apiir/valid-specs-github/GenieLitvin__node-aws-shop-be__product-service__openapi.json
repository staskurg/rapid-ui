          "path": "/products/{id}",
          "parameters": [
            {
              "in": "path",
              "name": "id",
              "schema": {
                "type": "string"
              }
            }
          ],
          "identifierParam": "id",
          "responseSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "price": {
                "type": "number"
              },
              "count": {
                "type": "number"
              }
            }
          }
        },
        {
          "id": "POST:/products",
          "method": "POST",
          "kind": "create",
          "path": "/products",
          "parameters": [],
          "requestSchema": {
            "type": "object",
            "required": [
              "id",
              "title",
              "description",
              "price",
              "count"
            ],
            "properties": {
              "id": {
                "type": "string",
                "example": "19ba3d6a-f8ed-491b-a192-0a33b71b38c4"
              },
              "title": {
                "type": "string",
                "example": "Product Title"
              },
              "description": {
                "type": "string",
                "example": "This product ..."
              },
              "price": {
                "type": "number",
                "example": 200
              },
              "count": {
                "type": "number",
                "example": 10
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
