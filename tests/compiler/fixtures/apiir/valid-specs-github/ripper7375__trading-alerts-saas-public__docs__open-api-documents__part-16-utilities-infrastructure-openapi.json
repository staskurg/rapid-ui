        },
        {
          "id": "GET:/internal/metrics",
          "method": "GET",
          "kind": "list",
          "path": "/internal/metrics",
          "parameters": [],
          "responseSchema": {
            "type": "object",
            "description": "System performance metrics",
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "uptime": {
                "type": "integer",
                "description": "Uptime in seconds"
              },
              "memory": {
                "type": "object",
                "properties": {
                  "used": {
                    "type": "integer",
                    "description": "Used memory in bytes"
                  },
                  "total": {
                    "type": "integer",
                    "description": "Total memory in bytes"
                  },
                  "percentage": {
                    "type": "number",
                    "format": "float"
                  }
                }
              },
              "cpu": {
                "type": "object",
                "properties": {
                  "usage": {
                    "type": "number",
                    "format": "float",
                    "description": "CPU usage percentage"
                  }
                }
              },
              "requests": {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "integer"
                  },
                  "perSecond": {
                    "type": "number",
                    "format": "float"
                  },
                  "averageLatency": {
                    "type": "integer",
                    "description": "Average latency in milliseconds"
                  },
                  "errorRate": {
                    "type": "number",
                    "format": "float"
                  }
                }
              },
              "cache": {
                "type": "object",
                "properties": {
                  "hitRate": {
                    "type": "number",
                    "format": "float"
                  },
                  "keys": {
                    "type": "integer"
                  },
                  "memoryUsed": {
                    "type": "integer"
                  }
                }
              },
              "activeConnections": {
                "type": "object",
                "properties": {
                  "database": {
                    "type": "integer"
                  },
                  "redis": {
                    "type": "integer"
                  },
                  "websocket": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
