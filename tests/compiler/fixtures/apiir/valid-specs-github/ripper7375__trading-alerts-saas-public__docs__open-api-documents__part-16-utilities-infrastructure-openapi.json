{
  "apiIrVersion": 1,
  "api": {
    "title": "Trading Alerts SaaS - Utilities & Infrastructure (Part 16)",
    "version": "2.0.0"
  },
  "resources": [
    {
      "name": "Infrastructure",
      "key": "infrastructure",
      "operations": [
        {
          "id": "GET:/internal/health",
          "method": "GET",
          "kind": "list",
          "path": "/internal/health",
          "parameters": [],
          "responseSchema": {
            "type": "object",
            "description": "System health check response",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "healthy",
                  "degraded",
                  "unhealthy"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "version": {
                "type": "string",
                "example": "2.0.0"
              },
              "services": {
                "type": "object",
                "properties": {
                  "database": {
                    "type": "object",
                    "description": "Individual service health status",
                    "properties": {
                      "status": {
                        "type": "string",
                        "enum": [
                          "up",
                          "down",
                          "degraded"
                        ]
                      },
                      "latency": {
                        "type": "integer",
                        "description": "Response time in milliseconds"
                      },
                      "lastChecked": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "error": {
                        "type": "string",
                        "nullable": true
                      }
                    }
                  },
                  "redis": {
                    "type": "object",
                    "description": "Individual service health status",
                    "properties": {
                      "status": {
                        "type": "string",
                        "enum": [
                          "up",
                          "down",
                          "degraded"
                        ]
                      },
                      "latency": {
                        "type": "integer",
                        "description": "Response time in milliseconds"
                      },
                      "lastChecked": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "error": {
                        "type": "string",
                        "nullable": true
                      }
                    }
                  },
                  "email": {
                    "type": "object",
                    "description": "Individual service health status",
                    "properties": {
                      "status": {
                        "type": "string",
                        "enum": [
                          "up",
                          "down",
                          "degraded"
                        ]
                      },
                      "latency": {
                        "type": "integer",
                        "description": "Response time in milliseconds"
                      },
                      "lastChecked": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "error": {
                        "type": "string",
                        "nullable": true
                      }
                    }
                  },
                  "mt5Api": {
                    "type": "object",
