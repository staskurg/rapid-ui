                "example": true
              },
              "data": {
                "type": "object",
                "properties": {
                  "history": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "example": "hist-abc-123"
                        },
                        "pool_id": {
                          "type": "string",
                          "example": "pool-001"
                        },
                        "pool_name": {
                          "type": "string",
                          "example": "Featured Banner"
                        },
                        "item_master_id": {
                          "type": "string",
                          "example": "char-001"
                        },
                        "item_name": {
                          "type": "string",
                          "example": "Hero Character"
                        },
                        "rarity": {
                          "type": "string",
                          "enum": [
                            "N",
                            "R",
                            "SR",
                            "SSR",
                            "UR"
                          ],
                          "example": "SSR"
                        },
                        "pity_count": {
                          "type": "integer",
                          "example": 45
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time",
                          "example": "2024-01-01T12:00:00Z"
                        }
                      }
                    }
                  },
                  "total": {
                    "type": "integer",
                    "example": 100
                  }
                }
              }
            }
          }
        },
