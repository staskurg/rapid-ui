{
  "api": {
    "title": "Game Backend API",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "auth",
      "key": "auth",
      "operations": [
        {
          "id": "guestAuth",
          "method": "POST",
          "kind": "create",
          "path": "/v1/auth/guest",
          "requestSchema": {
            "type": "object",
            "required": [
              "device_id",
              "device_type"
            ],
            "properties": {
              "device_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "description": "Unique device identifier",
                "example": "device-abc-123"
              },
              "device_type": {
                "type": "string",
                "enum": [
                  "ios",
                  "android",
                  "web"
                ],
                "example": "ios"
              },
              "device_name": {
                "type": "string",
                "maxLength": 255,
                "description": "Human-readable device name",
                "example": "iPhone 15 Pro"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "success": {
                "type": "boolean",
                "example": true
              },
              "data": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "string",
                    "example": "usr-abc-123"
                  },
                  "player_id": {
                    "type": "string",
                    "example": "PLY123456"
                  },
                  "access_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs..."
                  },
                  "refresh_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs..."
                  },
                  "is_guest": {
                    "type": "boolean",
                    "example": true
                  }
                }
              }
            }
          }
        },
        {
          "id": "refreshToken",
          "method": "POST",
          "kind": "create",
          "path": "/v1/auth/refresh",
          "requestSchema": {
            "type": "object",
            "required": [
              "refresh_token"
            ],
            "properties": {
              "refresh_token": {
                "type": "string",
                "minLength": 1,
                "description": "Refresh token from previous authentication",
                "example": "eyJhbGciOiJIUzI1NiIs..."
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "success": {
                "type": "boolean",
                "example": true
              },
              "data": {
                "type": "object",
                "properties": {
                  "access_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs..."
                  },
                  "refresh_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs..."
                  }
                }
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": false,
        "detail": false,
        "create": true,
        "update": false,
        "delete": false
      }
    },
