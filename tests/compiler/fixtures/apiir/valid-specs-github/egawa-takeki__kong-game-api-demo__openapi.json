        {
          "id": "drawGacha",
          "method": "POST",
          "kind": "create",
          "path": "/v1/gacha/draw",
          "requestSchema": {
            "type": "object",
            "required": [
              "pool_id",
              "draw_count"
            ],
            "properties": {
              "pool_id": {
                "type": "string",
                "minLength": 1,
                "description": "Target gacha pool ID",
                "example": "pool-001"
              },
              "draw_count": {
                "type": "integer",
                "enum": [
                  1,
                  10
                ],
                "description": "Number of draws (1 for single, 10 for multi)",
                "example": 10
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "success": {
                "type": "boolean",
                "example": true
              },
              "data": {
                "type": "object",
                "properties": {
                  "saga_id": {
                    "type": "string",
                    "example": "saga-abc-123"
                  },
                  "status": {
                    "type": "string",
                    "example": "COMPLETED"
                  },
                  "results": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "item_master_id": {
                          "type": "string",
                          "example": "char-001"
                        },
                        "name": {
                          "type": "string",
                          "example": "Hero Character"
                        },
                        "rarity": {
                          "type": "string",
                          "enum": [
                            "N",
                            "R",
                            "SR",
                            "SSR",
                            "UR"
                          ],
                          "example": "SSR"
                        },
                        "is_new": {
                          "type": "boolean",
                          "example": true
                        },
                        "is_pickup": {
                          "type": "boolean",
                          "example": true
                        }
                      }
                    }
                  },
                  "cost": {
                    "type": "object",
                    "properties": {
                      "currency_type": {
                        "type": "string",
                        "enum": [
                          "free_gem",
                          "paid_gem",
                          "gold"
                        ],
                        "example": "free_gem"
                      },
                      "amount": {
                        "type": "integer",
                        "example": 3000
                      }
                    }
                  },
                  "pity": {
                    "type": "object",
                    "properties": {
                      "count": {
                        "type": "integer",
                        "example": 45
                      },
                      "max_count": {
                        "type": "integer",
                        "example": 90
                      }
                    }
                  }
                }
              }
            }
          }
        }
