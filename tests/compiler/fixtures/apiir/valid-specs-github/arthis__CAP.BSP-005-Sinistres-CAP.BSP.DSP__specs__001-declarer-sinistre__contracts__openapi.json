                "type": "string",
                "example": "UP"
              }
            }
          }
        },
        {
          "id": "getReadiness",
          "method": "GET",
          "kind": "list",
          "path": "/health/readiness",
          "parameters": [],
          "responseSchema": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "example": "UP"
              },
              "checks": {
                "type": "object",
                "properties": {
                  "eventStoreDb": {
                    "type": "string",
                    "example": "UP"
                  },
                  "mongoDb": {
                    "type": "string",
                    "example": "UP"
                  },
                  "rabbitMq": {
                    "type": "string",
                    "example": "UP"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Queries",
      "key": "queries",
      "operations": [
        {
          "id": "listDeclarations",
          "method": "GET",
          "kind": "list",
          "path": "/declarations",
          "parameters": [
            {
              "in": "query",
              "name": "identifiantContrat",
              "schema": {
                "type": "string",
                "example": "CONTRAT-2026-001"
              }
            },
            {
              "in": "query",
              "name": "limit",
              "schema": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "default": 20
              }
            },
            {
              "in": "query",
              "name": "offset",
              "schema": {
                "type": "integer",
                "minimum": 0,
                "default": 0
              }
            },
            {
              "in": "query",
              "name": "statut",
              "schema": {
                "type": "string",
                "enum": [
                  "DECLARE",
                  "VALIDE",
                  "ANNULE"
                ]
              }
            }
          ],
          "queryParamCount": 4,
          "responseSchema": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "identifiantSinistre": {
                      "type": "string",
                      "pattern": "^SIN-\\d{4}-\\d{6}$",
                      "example": "SIN-2026-000001"
                    },
                    "identifiantContrat": {
                      "type": "string",
                      "example": "CONTRAT-2026-001"
                    },
                    "typeSinistre": {
                      "type": "string",
                      "example": "ACCIDENT_CORPOREL"
                    },
                    "typeSinistreLibelle": {
                      "type": "string",
                      "description": "Human-readable label for claim type (from reference database)",
                      "example": "Accident corporel"
                    },
                    "dateSurvenance": {
                      "type": "string",
                      "format": "date",
                      "example": "2026-01-20"
                    },
                    "dateDeclaration": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-01-27T14:30:00.000Z"
                    },
                    "statut": {
                      "type": "string",
                      "enum": [
                        "DECLARE",
                        "VALIDE",
                        "ANNULE"
                      ],
                      "example": "DECLARE"
                    },
                    "version": {
                      "type": "integer",
                      "description": "Event stream version (for optimistic concurrency)",
                      "example": 1
                    }
                  }
                }
              },
              "total": {
                "type": "integer",
                "description": "Total number of results matching query (without pagination)",
                "example": 42
              },
              "limit": {
                "type": "integer",
                "example": 20
              },
              "offset": {
                "type": "integer",
                "example": 0
              }
            }
          }
        },
        {
          "id": "getDeclarationById",
          "method": "GET",
          "kind": "detail",
          "path": "/declarations/{identifiantSinistre}",
          "parameters": [
