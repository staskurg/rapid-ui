              "schema": {
                "type": "string",
                "pattern": "^SIN-\\d{4}-\\d{6}$",
                "example": "SIN-2026-000001"
              }
            }
          ],
          "identifierParam": "identifiantSinistre",
          "responseSchema": {
            "type": "object",
            "properties": {
              "identifiantSinistre": {
                "type": "string",
                "pattern": "^SIN-\\d{4}-\\d{6}$",
                "example": "SIN-2026-000001"
              },
              "identifiantContrat": {
                "type": "string",
                "example": "CONTRAT-2026-001"
              },
              "typeSinistre": {
                "type": "string",
                "example": "ACCIDENT_CORPOREL"
              },
              "typeSinistreLibelle": {
                "type": "string",
                "description": "Human-readable label for claim type (from reference database)",
                "example": "Accident corporel"
              },
              "dateSurvenance": {
                "type": "string",
                "format": "date",
                "example": "2026-01-20"
              },
              "dateDeclaration": {
                "type": "string",
                "format": "date-time",
                "example": "2026-01-27T14:30:00.000Z"
              },
              "statut": {
                "type": "string",
                "enum": [
                  "DECLARE",
                  "VALIDE",
                  "ANNULE"
                ],
                "example": "DECLARE"
              },
              "version": {
                "type": "integer",
                "description": "Event stream version (for optimistic concurrency)",
                "example": 1
              }
            }
          }
        }
      ]
    }
  ]
