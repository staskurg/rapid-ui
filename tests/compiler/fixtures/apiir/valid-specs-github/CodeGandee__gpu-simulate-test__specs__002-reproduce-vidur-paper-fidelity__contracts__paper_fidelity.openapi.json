{
  "apiIrVersion": 1,
  "api": {
    "title": "Paper Fidelity Workflow API (Design Contract)",
    "version": "0.1.0"
  },
  "resources": [
    {
      "name": "Paper-fidelity",
      "key": "paper-fidelity",
      "operations": [
        {
          "id": "discoverCapacity",
          "method": "POST",
          "kind": "create",
          "path": "/v1/paper-fidelity/capacity",
          "parameters": [],
          "requestSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario_name",
              "backend",
              "trace_source",
              "criterion"
            ],
            "properties": {
              "scenario_name": {
                "type": "string",
                "minLength": 1,
                "description": "Stable identifier for a scenario (used in output paths and reports)."
              },
              "backend": {
                "type": "string",
                "enum": [
                  "sarathi"
                ]
              },
              "trace_source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "path"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "vidur_processed_lengths_csv",
                      "trace_csv",
                      "legacy_workload_dir"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "description": "Absolute filesystem path on the host running the workflow.",
                    "pattern": "^/"
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 4096
                  },
                  "num_requests": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Optional cap when sampling/shuffling a length distribution."
                  },
                  "seed": {
                    "type": "integer",
                    "description": "Seed for deterministic sampling/shuffle when applicable."
                  }
                }
              },
              "criterion": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "metric",
                  "quantile",
                  "threshold_s"
                ],
                "properties": {
                  "metric": {
                    "type": "string",
                    "enum": [
                      "request_scheduling_delay"
                    ]
                  },
                  "quantile": {
                    "type": "number",
                    "enum": [
                      0.99
                    ]
                  },
                  "threshold_s": {
                    "type": "number",
                    "minimum": 0,
                    "default": 5
                  }
                }
              },
              "search": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min_qps": {
                    "type": "number",
                    "minimum": 0
                  },
                  "max_qps": {
                    "type": "number",
                    "minimum": 0
                  },
                  "max_iters": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "operating_point_fraction": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.85
                  }
                }
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capacity_qps",
              "qps_85",
              "capacity_json",
              "run_meta_json"
            ],
            "properties": {
              "capacity_qps": {
                "type": "number",
                "minimum": 0
              },
              "qps_85": {
                "type": "number",
                "minimum": 0
              },
              "capacity_json": {
                "type": "string",
                "description": "Absolute filesystem path on the host running the workflow.",
                "pattern": "^/"
              },
              "run_meta_json": {
                "type": "string",
                "description": "Absolute filesystem path on the host running the workflow.",
                "pattern": "^/"
              }
            }
          }
        },
