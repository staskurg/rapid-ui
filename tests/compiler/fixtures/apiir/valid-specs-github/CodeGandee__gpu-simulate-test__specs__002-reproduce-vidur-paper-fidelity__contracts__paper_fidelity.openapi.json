                  "run_meta_json": {
                    "type": "string",
                    "description": "Absolute filesystem path on the host running the workflow.",
                    "pattern": "^/"
                  }
                }
              },
              "real": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "run_dir",
                  "request_metrics_csv",
                  "run_meta_json"
                ],
                "properties": {
                  "run_dir": {
                    "type": "string",
                    "description": "Absolute filesystem path on the host running the workflow.",
                    "pattern": "^/"
                  },
                  "request_metrics_csv": {
                    "type": "string",
                    "description": "Absolute filesystem path on the host running the workflow.",
                    "pattern": "^/"
                  },
                  "run_meta_json": {
                    "type": "string",
                    "description": "Absolute filesystem path on the host running the workflow.",
                    "pattern": "^/"
                  }
                }
              },
              "score": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "report_dir",
                  "summary_md"
                ],
                "properties": {
                  "report_dir": {
                    "type": "string",
                    "description": "Absolute filesystem path on the host running the workflow.",
                    "pattern": "^/"
                  },
                  "summary_md": {
                    "type": "string",
                    "description": "Absolute filesystem path on the host running the workflow.",
                    "pattern": "^/"
                  }
                }
              }
            }
          }
        },
