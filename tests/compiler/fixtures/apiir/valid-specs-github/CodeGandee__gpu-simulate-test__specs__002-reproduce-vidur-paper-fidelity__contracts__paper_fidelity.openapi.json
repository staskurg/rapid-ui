        {
          "id": "score",
          "method": "POST",
          "kind": "create",
          "path": "/v1/paper-fidelity/score",
          "parameters": [],
          "requestSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario_name",
              "sim_request_metrics_csv",
              "real_request_metrics_csv"
            ],
            "properties": {
              "scenario_name": {
                "type": "string",
                "minLength": 1,
                "description": "Stable identifier for a scenario (used in output paths and reports)."
              },
              "sim_request_metrics_csv": {
                "type": "string",
                "description": "Absolute filesystem path on the host running the workflow.",
                "pattern": "^/"
              },
              "real_request_metrics_csv": {
                "type": "string",
                "description": "Absolute filesystem path on the host running the workflow.",
                "pattern": "^/"
              },
              "percentiles": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "default": [
                  0.5,
                  0.95
                ]
              },
              "thresholds": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "pass_pct": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0.05
                  },
                  "warn_pct": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0.09
                  }
                }
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "additionalProperties": false,
