{
  "api": {
    "title": "Machine Learning Inference API",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Predict",
      "key": "predict",
      "operations": [
        {
          "id": "POST:/predict/regression",
          "method": "POST",
          "kind": "create",
          "path": "/predict/regression",
          "requestSchema": {
            "type": "object",
            "properties": {
              "features": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 10
              }
            },
            "required": [
              "features"
            ]
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "prediction": {
                "type": "number"
              }
            }
          }
        },
        {
          "id": "POST:/predict/text-clusters",
          "method": "POST",
          "kind": "create",
          "path": "/predict/text-clusters",
          "requestSchema": {
            "type": "object",
            "properties": {
              "documents": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "clusters": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        {
          "id": "POST:/predict/xgboost",
          "method": "POST",
          "kind": "create",
          "path": "/predict/xgboost",
          "requestSchema": {
            "type": "object",
            "properties": {
              "features": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "probability": {
                "type": "number"
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": false,
        "detail": false,
        "create": true,
        "update": false,
        "delete": false
      }
    }
  ]
}