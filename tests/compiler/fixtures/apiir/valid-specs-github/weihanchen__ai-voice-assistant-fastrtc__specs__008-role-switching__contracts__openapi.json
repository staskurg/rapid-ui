  "resources": [
    {
      "name": "Intent Recognition",
      "key": "intent-recognition",
      "operations": [
        {
          "id": "POST:/intent/recognize",
          "method": "POST",
          "kind": "create",
          "path": "/intent/recognize",
          "requestSchema": {
            "type": "object",
            "required": [
              "text",
              "session_id"
            ],
            "properties": {
              "text": {
                "type": "string",
                "description": "原始輸入文字"
              },
              "session_id": {
                "type": "string",
                "description": "會話 ID"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "success": {
                "type": "boolean",
                "example": true
              },
              "data": {
                "type": "object",
                "properties": {
                  "intent_type": {
                    "type": "string",
                    "enum": [
                      "role_switch",
                      "role_query",
                      "role_list",
                      "unknown"
                    ]
                  },
                  "confidence": {
                    "type": "number",
                    "format": "float",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "target_role": {
                    "type": "string",
                    "nullable": true
                  },
                  "original_text": {
                    "type": "string"
                  },
                  "processing_time_ms": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": false,
        "detail": false,
        "create": true,
        "update": false,
        "delete": false
      }
    },
