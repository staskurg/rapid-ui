    {
      "name": "Auth",
      "key": "auth",
      "operations": [
        {
          "id": "POST:/api/auth/register",
          "method": "POST",
          "kind": "create",
          "path": "/api/auth/register",
          "requestSchema": {
            "type": "object",
            "required": [
              "name",
              "email",
              "password",
              "planId"
            ],
            "properties": {
              "name": {
                "type": "string",
                "example": "John Doe"
              },
              "email": {
                "type": "string",
                "format": "email",
                "example": "john@example.com"
              },
              "password": {
                "type": "string",
                "minLength": 8,
                "example": "securepassword123"
              },
              "planId": {
                "type": "string",
                "example": "cmfb62xtq0000w5bnc9qjc1ly"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "success": {
                "type": "boolean",
                "example": true
              },
              "user": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": false,
        "detail": false,
        "create": true,
        "update": false,
        "delete": false
      }
    },
