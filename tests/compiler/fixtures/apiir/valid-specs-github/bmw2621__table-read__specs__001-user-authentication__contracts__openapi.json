{
  "api": {
    "title": "User Authentication API",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Authentication",
      "key": "authentication",
      "operations": [
        {
          "id": "getCsrfToken",
          "method": "GET",
          "kind": "list",
          "path": "/csrf",
          "responseSchema": {
            "type": "object",
            "properties": {
              "csrfToken": {
                "type": "string"
              },
              "status": {
                "type": "integer",
                "example": 200
              },
              "ok": {
                "type": "boolean",
                "example": true
              }
            }
          }
        },
        {
          "id": "getSession",
          "method": "GET",
          "kind": "list",
          "path": "/session",
          "responseSchema": {
            "type": "object",
            "properties": {
              "user": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Unique user identifier",
                    "example": "clx123abc456"
                  },
                  "username": {
                    "type": "string",
                    "description": "Unique username",
                    "example": "johndoe"
                  },
                  "name": {
                    "type": "string",
                    "nullable": true,
                    "description": "Display name",
                    "example": "John Doe"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "nullable": true,
                    "description": "Email address",
                    "example": "john@example.com"
                  },
                  "image": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "Profile image URL"
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Account creation timestamp",
                    "example": "2025-12-10T10:00:00Z"
                  }
                }
              },
              "expires": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "status": {
                "type": "integer",
                "example": 200
              },
              "ok": {
                "type": "boolean",
                "example": true
              }
            }
          }
        },
        {
          "id": "signIn",
          "method": "POST",
          "kind": "create",
          "path": "/signin",
          "requestSchema": {
            "type": "object",
            "required": [
              "username",
              "password"
            ],
            "properties": {
              "username": {
                "type": "string",
                "description": "Unique username",
                "example": "johndoe"
              },
              "password": {
                "type": "string",
                "format": "password",
                "description": "User password",
                "example": "SecurePassword123!"
              },
              "redirect": {
                "type": "boolean",
                "default": true,
                "description": "Whether to redirect after sign in"
              },
              "callbackUrl": {
                "type": "string",
                "format": "uri",
                "description": "URL to redirect after sign in"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "error": {
                "type": "string",
                "nullable": true
              },
              "status": {
                "type": "integer",
                "example": 200
              },
              "ok": {
                "type": "boolean",
                "example": true
              }
            }
          }
        },
        {
          "id": "signOut",
          "method": "POST",
          "kind": "create",
          "path": "/signout",
          "requestSchema": {
            "type": "object",
            "properties": {
              "redirect": {
                "type": "boolean",
                "default": true
              },
              "callbackUrl": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "status": {
                "type": "integer",
                "example": 200
              },
              "ok": {
                "type": "boolean",
                "example": true
              }
            }
          }
        },
        {
          "id": "signUp",
          "method": "POST",
          "kind": "create",
          "path": "/signup",
          "requestSchema": {
            "type": "object",
            "required": [
              "username",
              "password"
            ],
            "properties": {
              "username": {
                "type": "string",
                "description": "Unique username",
                "example": "johndoe"
              },
              "password": {
                "type": "string",
                "format": "password",
                "description": "Password meeting security requirements",
                "example": "SecurePassword123!"
              },
              "name": {
                "type": "string",
                "description": "Display name",
                "example": "John Doe"
              },
              "email": {
                "type": "string",
                "format": "email",
                "description": "Email address",
                "example": "john@example.com"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "user": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Unique user identifier",
                    "example": "clx123abc456"
                  },
                  "username": {
                    "type": "string",
                    "description": "Unique username",
                    "example": "johndoe"
                  },
                  "name": {
                    "type": "string",
                    "nullable": true,
                    "description": "Display name",
                    "example": "John Doe"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "nullable": true,
                    "description": "Email address",
                    "example": "john@example.com"
                  },
                  "image": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "Profile image URL"
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Account creation timestamp",
                    "example": "2025-12-10T10:00:00Z"
                  }
                }
              },
              "status": {
                "type": "integer",
                "example": 201
              },
              "ok": {
                "type": "boolean",
                "example": true
              }
            }
          }
        }
      ]
    }
  ]
}