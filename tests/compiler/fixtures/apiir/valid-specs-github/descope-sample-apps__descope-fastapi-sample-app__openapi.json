{
  "api": {
    "title": "Descope FastAPI Sample App",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Private",
      "key": "private",
      "operations": [
        {
          "id": "getPrivateEndpoint",
          "method": "GET",
          "kind": "list",
          "path": "/api/private",
          "responseSchema": {
            "type": "object",
            "description": "JWT payload containing user information and claims",
            "additionalProperties": true
          }
        }
      ]
    },
    {
