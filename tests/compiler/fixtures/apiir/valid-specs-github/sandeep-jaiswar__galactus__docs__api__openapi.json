{
  "apiIrVersion": 1,
  "api": {
    "title": "Galactus Intent Inference API",
    "version": "0.1.0"
  },
  "resources": [
    {
      "name": "Intent Computation",
      "key": "intent-computation",
      "operations": [
        {
          "id": "computeIntent",
          "method": "POST",
          "kind": "create",
          "path": "/intent",
          "parameters": [],
          "requestSchema": {
            "type": "object",
            "required": [
              "signals",
              "client_id"
            ],
            "properties": {
              "signals": {
                "type": "array",
                "description": "Input signals for intent computation",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "value",
                    "confidence",
                    "timestamp"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Signal identifier",
                      "example": "oi_decay"
                    },
                    "value": {
                      "type": "number",
                      "format": "double",
                      "description": "Signal value",
                      "minimum": -1,
                      "maximum": 1,
                      "example": -0.4
                    },
                    "confidence": {
                      "type": "number",
                      "format": "double",
                      "description": "Signal confidence",
                      "minimum": 0,
                      "maximum": 1,
                      "example": 0.85
                    },
                    "timestamp": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Signal timestamp (Unix epoch)",
                      "example": 1703123456
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Signal-specific metadata",
                      "additionalProperties": true
                    }
                  }
                },
                "minItems": 1,
                "maxItems": 10
              },
              "client_id": {
                "type": "string",
                "description": "Client identifier for tracking",
                "example": "client_123"
              },
              "context": {
                "type": "object",
                "description": "Additional context data",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "metadata": {
                "type": "object",
                "description": "Request metadata",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "required": [
              "result",
              "timestamp"
            ],
            "properties": {
              "result": {
                "type": "object",
                "required": [
                  "intent"
                ],
                "properties": {
                  "intent": {
                    "type": "object",
                    "required": [
                      "pressure",
                      "confidence",
                      "timestamp"
                    ],
                    "properties": {
                      "pressure": {
                        "type": "number",
                        "format": "double",
                        "description": "Capital pressure direction",
                        "minimum": -1,
                        "maximum": 1,
                        "example": -0.25
                      },
                      "confidence": {
                        "type": "number",
                        "format": "double",
                        "description": "Confidence in inference",
                        "minimum": 0,
                        "maximum": 1,
                        "example": 0.82
                      },
                      "regime": {
                        "type": "string",
                        "description": "Market regime classification",
                        "enum": [
                          "bull",
                          "bear",
                          "neutral",
                          "transition"
                        ],
                        "example": "bear"
                      },
                      "signals": {
                        "type": "object",
                        "description": "Contributing signals",
                        "additionalProperties": {
                          "type": "object",
                          "required": [
                            "value",
                            "weight",
                            "confidence"
                          ],
                          "properties": {
                            "value": {
                              "type": "number",
                              "format": "double",
                              "description": "Signal value",
                              "minimum": -1,
                              "maximum": 1
                            },
                            "weight": {
                              "type": "number",
                              "format": "double",
                              "description": "Signal weight in aggregation",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "confidence": {
                              "type": "number",
                              "format": "double",
                              "description": "Signal confidence",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "metadata": {
                              "type": "object",
                              "additionalProperties": true
                            }
                          }
                        }
                      },
                      "timestamp": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Computation timestamp (Unix epoch)"
                      }
                    }
                  },
                  "alternatives": {
                    "type": "array",
                    "description": "Alternative intent interpretations",
                    "items": {
                      "type": "object",
                      "required": [
                        "pressure",
                        "confidence",
                        "timestamp"
                      ],
                      "properties": {
                        "pressure": {
                          "type": "number",
                          "format": "double",
                          "description": "Capital pressure direction",
                          "minimum": -1,
                          "maximum": 1,
                          "example": -0.25
                        },
                        "confidence": {
                          "type": "number",
                          "format": "double",
                          "description": "Confidence in inference",
                          "minimum": 0,
                          "maximum": 1,
                          "example": 0.82
                        },
                        "regime": {
                          "type": "string",
                          "description": "Market regime classification",
                          "enum": [
                            "bull",
                            "bear",
                            "neutral",
                            "transition"
                          ],
                          "example": "bear"
                        },
                        "signals": {
                          "type": "object",
                          "description": "Contributing signals",
                          "additionalProperties": {
                            "type": "object",
                            "required": [
                              "value",
                              "weight",
                              "confidence"
                            ],
                            "properties": {
                              "value": {
                                "type": "number",
                                "format": "double",
                                "description": "Signal value",
                                "minimum": -1,
                                "maximum": 1
                              },
                              "weight": {
                                "type": "number",
                                "format": "double",
                                "description": "Signal weight in aggregation",
                                "minimum": 0,
                                "maximum": 1
                              },
                              "confidence": {
                                "type": "number",
                                "format": "double",
                                "description": "Signal confidence",
                                "minimum": 0,
                                "maximum": 1
                              },
                              "metadata": {
                                "type": "object",
                                "additionalProperties": true
                              }
                            }
                          }
                        },
                        "timestamp": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Computation timestamp (Unix epoch)"
                        }
                      }
                    }
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "processing_time_ns": {
                    "type": "integer",
                    "format": "int64",
                    "description": "Processing time in nanoseconds"
                  }
                }
              },
              "metadata": {
                "type": "object",
                "description": "Response metadata",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "timestamp": {
                "type": "integer",
                "format": "int64",
                "description": "Response timestamp (Unix epoch)"
              }
            }
          }
        },
