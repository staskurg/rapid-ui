              },
              "latitude": {
                "type": "string",
                "example": "37.3861"
              },
              "longitude": {
                "type": "string",
                "example": "-122.0839"
              },
              "timezone": {
                "type": "string",
                "example": "America/Los_Angeles"
              },
              "asn": {
                "type": "integer",
                "example": 15169
              },
              "isp": {
                "type": "string",
                "example": "Google LLC"
              }
            }
          }
        }
      ]
    }
  ]
