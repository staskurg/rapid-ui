{
  "apiIrVersion": 1,
  "api": {
    "title": "Galileo Geolocation API",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Resource",
      "key": "resource",
      "operations": [
        {
          "id": "GET:/",
          "method": "GET",
          "kind": "list",
          "path": "/",
          "parameters": [],
          "responseSchema": {
            "type": "object",
            "properties": {
              "ip": {
                "type": "string",
                "example": "8.8.8.8"
              },
              "country": {
                "type": "string",
                "example": "US"
              },
              "region": {
                "type": "string",
