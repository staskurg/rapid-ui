      "operations": [
        {
          "id": "getFlights",
          "method": "GET",
          "kind": "list",
          "path": "/flights",
          "parameters": [],
          "responseSchema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "flightNumber",
                    "origin",
                    "destination",
                    "departureTime",
                    "arrivalTime",
                    "airline",
                    "status",
                    "price",
                    "seats"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier for the flight",
                      "example": "1"
                    },
                    "flightNumber": {
                      "type": "string",
                      "description": "IATA flight number",
                      "example": "AA101"
                    },
                    "origin": {
                      "type": "string",
                      "description": "IATA code for the origin airport",
                      "example": "JFK"
                    },
                    "destination": {
                      "type": "string",
                      "description": "IATA code for the destination airport",
                      "example": "LAX"
                    },
                    "departureTime": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Scheduled departure time (ISO 8601)",
                      "example": "2026-03-10T08:00:00Z"
                    },
                    "arrivalTime": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Scheduled arrival time (ISO 8601)",
                      "example": "2026-03-10T11:30:00Z"
                    },
                    "airline": {
                      "type": "string",
                      "description": "Name of the airline operating the flight",
                      "example": "American Airlines"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "scheduled",
                        "boarding",
                        "departed",
                        "arrived",
                        "cancelled"
                      ],
                      "description": "Current status of the flight",
                      "example": "scheduled"
                    },
                    "price": {
                      "type": "number",
                      "format": "float",
                      "description": "Ticket price in USD",
                      "example": 299.99
                    },
                    "seats": {
                      "type": "integer",
                      "description": "Total number of seats available",
                      "example": 150
                    }
                  }
                }
              },
              "total": {
                "type": "integer",
                "example": 2
              }
            }
          }
        },
