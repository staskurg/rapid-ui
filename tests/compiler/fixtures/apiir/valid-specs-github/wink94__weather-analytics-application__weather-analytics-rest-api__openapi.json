{
  "apiIrVersion": 1,
  "api": {
    "title": "Weather Analytics API",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Health",
      "key": "health",
      "operations": [
        {
          "id": "GET:/health",
          "method": "GET",
          "kind": "list",
          "path": "/health",
          "parameters": [],
          "responseSchema": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "UP"
                ]
              }
            }
          }
        }
      ]
    },
    {
      "name": "Kpi",
      "key": "kpi",
      "operations": [
        {
          "id": "GET:/kpi",
          "method": "GET",
          "kind": "list",
          "path": "/kpi",
          "parameters": [
            {
              "in": "query",
              "name": "endDate",
              "schema": {
                "type": "string",
                "format": "date-time",
                "example": "2006-07-27 23:00:00"
              },
              "format": "date-time"
            },
            {
              "in": "query",
              "name": "eventType",
              "schema": {
                "type": "string",
                "enum": [
                  "SUMMARY",
                  "PRECIP_TYPE"
                ]
              },
              "required": true
            },
            {
              "in": "query",
              "name": "startDate",
              "schema": {
                "type": "string",
                "format": "date-time",
                "example": "2006-04-01 20:00:00"
              },
              "format": "date-time"
            },
            {
              "in": "query",
              "name": "timestamp",
              "schema": {
                "type": "string",
                "enum": [
                  "CUSTOM",
                  "DAY",
                  "MONTH",
                  "YEAR"
                ]
              },
              "required": true
            }
          ],
          "queryParamCount": 4,
          "responseSchema": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "example": "SUMMARY"
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "example": "Partly Cloudy"
                    },
                    "value": {
                      "type": "integer",
                      "example": 33
                    }
                  }
                }
              },
              "unit": {
                "type": "string",
                "example": "%"
              }
            }
          }
        }
      ]
    }
  ]
