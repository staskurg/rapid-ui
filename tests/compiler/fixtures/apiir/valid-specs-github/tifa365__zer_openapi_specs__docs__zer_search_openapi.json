{
  "apiIrVersion": 1,
  "api": {
    "title": "ZER Charity Search API",
    "version": "1.0.1"
  },
  "resources": [
    {
      "name": "Search",
      "key": "search",
      "operations": [
        {
          "id": "GET:/search",
          "method": "GET",
          "kind": "list",
          "path": "/search",
          "parameters": [
            {
              "in": "query",
              "name": "bundesland",
              "schema": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2
              }
            },
            {
              "in": "query",
              "name": "label",
              "schema": {
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "ort",
              "schema": {
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "page",
              "schema": {
                "type": "integer",
                "minimum": 1,
                "default": 1
              }
            },
            {
              "in": "query",
              "name": "pageSize",
              "schema": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "default": 10
              }
            },
            {
              "in": "query",
              "name": "plz",
              "schema": {
                "type": "string",
                "pattern": "^\\d{5}$"
              }
            },
            {
              "in": "query",
              "name": "sortBy",
              "schema": {
                "type": "string",
                "enum": [
                  "label",
                  "plz",
                  "ort"
                ]
              }
            },
            {
              "in": "query",
              "name": "sortOrder",
              "schema": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ],
                "default": "asc"
              }
            },
            {
              "in": "query",
              "name": "staat",
              "schema": {
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "zwecke",
              "schema": {
                "type": "integer"
              }
            }
          ],
          "queryParamCount": 10,
          "responseSchema": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer"
              },
              "pageSize": {
                "type": "integer"
              },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "wid": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "description": "URL of the organization (may be empty)"
                    },
                    "plz": {
                      "type": "string"
                    },
                    "ort": {
                      "type": "string"
                    },
                    "bundesland": {
                      "type": "string",
                      "nullable": true
                    },
                    "strasse": {
                      "type": "string"
                    },
                    "hausnummer": {
                      "type": "string"
                    },
                    "hausnummerzusatz": {
                      "type": "string",
                      "nullable": true
                    },
                    "postfach": {
                      "type": "string"
                    },
                    "staat": {
                      "type": "string"
                    },
                    "spendenkonten": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "zwecke": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "zustaendigesFinanzamt": {
                      "type": "string"
                    },
                    "freistellungbescheidErteilungAm": {
                      "type": "string",
                      "format": "date",
                      "nullable": true
                    },
                    "feststellungbescheidErteilungAm": {
                      "type": "string",
                      "format": "date",
                      "nullable": true
                    },
                    "anerkennungAlsParteiAm": {
                      "type": "string",
                      "format": "date",
                      "nullable": true
                    },
                    "anerkennungAlsWaehlervereinigungAm": {
                      "type": "string",
                      "format": "date",
                      "nullable": true
                    },
                    "anerkennungAlsParteiAmOderWaehlervereinigungAm": {
                      "type": "string",
                      "format": "date",
                      "nullable": true
                    },
                    "juristischePersonDesOEffentlichenRechtsStatus": {
                      "type": "string",
                      "description": "Status as a legal entity under public law"
                    },
                    "uuid": {
                      "type": "integer",
                      "description": "Unique identifier for the organization"
                    }
                  },
                  "required": [
                    "label",
                    "plz",
                    "ort",
                    "bundesland",
                    "uuid"
                  ]
                }
              },
              "sortBy": {
                "type": "string"
              },
              "sortOrder": {
                "type": "string"
              },
              "totalCount": {
                "type": "integer"
              },
              "totalPages": {
                "type": "integer"
              }
            },
            "required": [
              "page",
              "pageSize",
              "results",
              "sortBy",
              "sortOrder",
              "totalCount",
              "totalPages"
            ]
          }
        }
      ]
    }
  ]
}