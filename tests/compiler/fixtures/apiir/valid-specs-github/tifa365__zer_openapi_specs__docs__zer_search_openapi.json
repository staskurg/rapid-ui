{
  "api": {
    "title": "ZER Charity Search API",
    "version": "1.0.1"
  },
  "resources": [
    {
      "name": "Search",
      "key": "search",
      "operations": [
        {
          "id": "GET:/search",
          "method": "GET",
          "kind": "list",
          "path": "/search",
          "queryParamCount": 10,
          "responseSchema": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer"
              },
              "pageSize": {
                "type": "integer"
              },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "wid": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "description": "URL of the organization (may be empty)"
                    },
                    "plz": {
                      "type": "string"
                    },
                    "ort": {
                      "type": "string"
                    },
                    "bundesland": {
                      "type": "string",
                      "nullable": true
                    },
                    "strasse": {
                      "type": "string"
                    },
                    "hausnummer": {
                      "type": "string"
                    },
                    "hausnummerzusatz": {
                      "type": "string",
                      "nullable": true
                    },
                    "postfach": {
                      "type": "string"
                    },
                    "staat": {
                      "type": "string"
                    },
                    "spendenkonten": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "zwecke": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "zustaendigesFinanzamt": {
                      "type": "string"
                    },
                    "freistellungbescheidErteilungAm": {
                      "type": "string",
                      "format": "date",
                      "nullable": true
                    },
                    "feststellungbescheidErteilungAm": {
                      "type": "string",
                      "format": "date",
                      "nullable": true
                    },
                    "anerkennungAlsParteiAm": {
                      "type": "string",
                      "format": "date",
                      "nullable": true
                    },
                    "anerkennungAlsWaehlervereinigungAm": {
                      "type": "string",
                      "format": "date",
                      "nullable": true
                    },
                    "anerkennungAlsParteiAmOderWaehlervereinigungAm": {
                      "type": "string",
                      "format": "date",
                      "nullable": true
                    },
                    "juristischePersonDesOEffentlichenRechtsStatus": {
                      "type": "string",
                      "description": "Status as a legal entity under public law"
                    },
                    "uuid": {
                      "type": "integer",
                      "description": "Unique identifier for the organization"
                    }
                  },
                  "required": [
                    "label",
                    "plz",
                    "ort",
                    "bundesland",
                    "uuid"
                  ]
                }
              },
              "sortBy": {
                "type": "string"
              },
              "sortOrder": {
                "type": "string"
              },
              "totalCount": {
                "type": "integer"
              },
              "totalPages": {
                "type": "integer"
              }
            },
            "required": [
              "page",
              "pageSize",
              "results",
              "sortBy",
              "sortOrder",
              "totalCount",
              "totalPages"
            ]
          }
        }
      ],
      "capabilities": {
        "list": true,
        "detail": false,
        "create": false,
        "update": false,
        "delete": false
      }
    }
  ]
}