{
  "apiIrVersion": 1,
  "api": {
    "title": "AQI Nowcast & Alerts – Delhi NCR",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Forecast",
      "key": "forecast",
      "operations": [
        {
          "id": "GET:/forecast",
          "method": "GET",
          "kind": "list",
          "path": "/forecast",
          "parameters": [],
          "responseSchema": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string",
                "example": "ncr"
              },
              "hour": {
                "type": "string",
                "format": "date-time",
                "example": "2025-09-05T18:00:00Z"
              },
              "pm25_mean": {
                "type": "number",
                "example": 47.5
              },
              "pm25_low": {
                "type": "number",
                "example": 40.1
              },
              "pm25_high": {
                "type": "number",
                "example": 55.3
              },
              "samples": {
                "type": "integer",
                "example": 24
              },
              "method": {
                "type": "string",
                "example": "hourly-mean±std"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Healthz",
      "key": "healthz",
      "operations": [
        {
          "id": "GET:/healthz",
          "method": "GET",
          "kind": "list",
          "path": "/healthz",
          "parameters": [],
          "responseSchema": {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean",
                "example": true
              }
            }
          }
        }
      ]
    },
    {
      "name": "Timeseries",
      "key": "timeseries",
      "operations": [
        {
          "id": "GET:/timeseries",
          "method": "GET",
          "kind": "list",
          "path": "/timeseries",
          "parameters": [],
          "responseSchema": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string",
                "example": "ncr"
              },
              "hours": {
                "type": "integer",
                "example": 72
              },
              "series": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ts": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2025-09-05T17:00:00Z"
                    },
                    "pm25": {
                      "type": "number",
                      "example": 52.4
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}