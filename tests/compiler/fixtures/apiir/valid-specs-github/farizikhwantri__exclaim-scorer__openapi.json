              },
              "task": {
                "type": "string",
                "nullable": true
              },
              "assurance_case_json": {
                "type": "object",
                "description": "Assurance case JSON without scores"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "required": [
              "model_type",
              "model_name",
              "scored_json"
            ],
            "properties": {
              "model_type": {
                "type": "string"
              },
              "model_name": {
                "type": "string"
              },
              "scored_json": {
                "type": "object"
              }
