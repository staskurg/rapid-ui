    {
      "name": "payments",
      "key": "payments",
      "operations": [
        {
          "id": "POST:/payments/callback",
          "method": "POST",
          "kind": "create",
          "path": "/payments/callback",
          "requestSchema": {
            "type": "object",
            "required": [
              "order_id",
              "provider_txn_id",
              "status"
            ],
            "properties": {
              "order_id": {
                "type": "string"
              },
              "provider_txn_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "description": "Only SUCCESS is accepted."
              },
              "partition_key": {
                "type": "string"
              },
              "hold_id": {
                "type": "string"
              },
              "signature": {
                "type": "string",
                "description": "Optional unless PAYMENT_CALLBACK_SIGN_KEY is configured; HMAC-SHA256 hex of order_id|provider_txn_id|status."
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "description": "Current runtime returns PascalCase fields from `domain.Order`.\n",
            "properties": {
              "OrderID": {
                "type": "string"
              },
              "IdempotencyKey": {
                "type": "string"
              },
              "Status": {
                "type": "string",
                "enum": [
                  "INIT",
                  "RESERVED",
                  "PAID",
                  "TICKETED",
                  "CANCELLED"
                ]
              },
              "AmountCents": {
                "type": "integer",
                "format": "int64"
              },
