{
  "apiIrVersion": 1,
  "api": {
    "title": "Bitcoin Transaction API",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Networkfee",
      "key": "networkfee",
      "operations": [
        {
          "id": "GET:/networkFee",
          "method": "GET",
          "kind": "list",
          "path": "/networkFee",
          "parameters": [],
          "responseSchema": {
            "type": "object",
            "properties": {
              "is_error": {
                "type": "boolean"
              },
              "data": {
                "type": "object",
                "properties": {
                  "fastestFee": {
                    "type": "integer",
                    "description": "Fee rate for fastest confirmation (sats/vB)"
                  },
                  "halfHourFee": {
                    "type": "integer",
                    "description": "Fee rate for confirmation within 30 minutes (sats/vB)"
                  },
                  "hourFee": {
                    "type": "integer",
                    "description": "Fee rate for confirmation within 1 hour (sats/vB)"
                  },
                  "economyFee": {
                    "type": "integer",
                    "description": "Fee rate for economy transaction (sats/vB)"
                  },
                  "minimumFee": {
                    "type": "integer",
                    "description": "Minimum fee rate (sats/vB)"
                  }
                }
              },
              "error_msg": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      ]
    },
    {
      "name": "Transaction",
      "key": "transaction",
      "operations": [
        {
          "id": "POST:/transaction/broadcast",
          "method": "POST",
          "kind": "create",
          "path": "/transaction/broadcast",
          "parameters": [],
          "requestSchema": {
            "type": "object",
            "required": [
              "signed_raw_txn"
            ],
            "properties": {
              "signed_raw_txn": {
                "type": "string",
                "description": "Signed raw transaction hex string"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "is_error": {
                "type": "boolean"
              },
              "data": {
                "type": "object",
                "properties": {
                  "response": {
                    "type": "string",
                    "description": "Transaction broadcast response"
                  }
                }
              },
              "error_msg": {
                "type": "string",
                "nullable": true
              }
            }
          }
        },
        {
          "id": "POST:/transaction/createTransaction",
          "method": "POST",
          "kind": "create",
          "path": "/transaction/createTransaction",
          "parameters": [],
          "requestSchema": {
            "type": "object",
            "required": [
              "from_address",
              "to_address",
              "amount",
              "fee"
            ],
            "properties": {
              "from_address": {
                "type": "string",
                "description": "Sender's Bitcoin address"
              },
              "to_address": {
                "type": "string",
                "description": "Recipient's Bitcoin address"
              },
              "amount": {
                "type": "integer",
                "format": "int64",
                "description": "Amount to send in satoshis"
              },
              "fee": {
                "type": "integer",
                "format": "int64",
                "description": "Transaction fee in satoshis"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "is_error": {
                "type": "boolean"
              },
              "data": {
                "type": "object",
                "properties": {
                  "unsigned_raw_txn": {
                    "type": "object",
                    "description": "Unsigned transaction data"
                  },
                  "used_utxos": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "txid": {
                          "type": "string"
                        },
                        "vout": {
                          "type": "integer"
                        },
                        "value": {
                          "type": "integer",
                          "description": "Amount in satoshis"
                        },
                        "status": {
                          "type": "object",
                          "properties": {
                            "confirmed": {
                              "type": "boolean"
                            },
                            "block_height": {
                              "type": "integer",
                              "nullable": true
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "error_msg": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      ]
    },
    {
      "name": "Validatetransaction",
      "key": "validatetransaction",
      "operations": [
        {
          "id": "GET:/validateTransaction/{transaction_hash}",
          "method": "GET",
          "kind": "detail",
          "path": "/validateTransaction/{transaction_hash}",
          "parameters": [
            {
              "in": "path",
              "name": "transaction_hash",
              "schema": {
                "type": "string"
              }
            }
          ],
          "identifierParam": "transaction_hash",
          "responseSchema": {
            "type": "object",
            "properties": {
              "is_error": {
                "type": "boolean"
              },
              "data": {
                "type": "object",
                "properties": {
                  "txn_hash": {
                    "type": "string"
                  },
                  "txn_status": {
                    "type": "string",
                    "enum": [
                      "Pending",
                      "Confirmed",
                      "Cancelled"
                    ]
                  },
                  "txn_data": {
                    "type": "object",
                    "properties": {
                      "block_index": {
                        "type": "integer",
                        "nullable": true
                      },
                      "block_height": {
                        "type": "integer",
                        "nullable": true
                      },
                      "consumed_fees": {
                        "type": "integer"
                      },
                      "txn_input_amount": {
                        "type": "integer"
                      },
                      "txn_output_amount": {
                        "type": "integer"
                      },
                      "input_txns": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "output_txns": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "error_msg": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      ]
    },
    {
      "name": "Walletbalance",
      "key": "walletbalance",
      "operations": [
        {
          "id": "GET:/walletBalance/{wallet_address}",
          "method": "GET",
          "kind": "detail",
          "path": "/walletBalance/{wallet_address}",
          "parameters": [
            {
              "in": "path",
              "name": "wallet_address",
              "schema": {
                "type": "string"
              }
            }
          ],
          "identifierParam": "wallet_address",
          "responseSchema": {
            "type": "object",
            "properties": {
              "is_error": {
                "type": "boolean"
              },
              "data": {
                "type": "object",
                "properties": {
                  "confirmed_balance": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "unconfirmed_balance": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "total_balance": {
                    "type": "integer",
                    "format": "int64"
                  }
                }
              },
              "error_msg": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      ]
    }
  ]
}