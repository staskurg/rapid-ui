{
  "api": {
    "title": "Task Manager API",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Tasks",
      "key": "tasks",
      "operations": [
        {
          "id": "getTasks",
          "method": "GET",
          "kind": "list",
          "path": "/api/tasks",
          "responseSchema": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title"
              ],
              "properties": {
                "_id": {
                  "type": "string",
                  "description": "The unique identifier for the task",
                  "example": "507f1f77bcf86cd799439011"
                },
                "title": {
                  "type": "string",
                  "description": "The title of the task",
                  "example": "Complete project documentation"
                },
                "description": {
                  "type": "string",
                  "description": "The description of the task",
                  "example": "Write comprehensive documentation for the API"
                },
                "completed": {
                  "type": "boolean",
                  "description": "Whether the task is completed",
                  "default": false,
                  "example": false
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "description": "The timestamp when the task was created",
                  "example": "2024-01-15T10:30:00Z"
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time",
                  "description": "The timestamp when the task was last updated",
                  "example": "2024-01-15T11:45:00Z"
                }
              }
            }
          }
        },
        {
          "id": "createTask",
          "method": "POST",
          "kind": "create",
          "path": "/api/tasks",
          "requestSchema": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string",
                "description": "The title of the task",
                "example": "Complete project documentation"
              },
              "description": {
                "type": "string",
                "description": "The description of the task",
                "example": "Write comprehensive documentation for the API"
              },
              "completed": {
                "type": "boolean",
                "description": "Whether the task is completed",
                "default": false,
                "example": false
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "_id": {
                "type": "string",
                "description": "The unique identifier for the task",
                "example": "507f1f77bcf86cd799439011"
              },
              "title": {
                "type": "string",
                "description": "The title of the task",
                "example": "Complete project documentation"
              },
              "description": {
                "type": "string",
                "description": "The description of the task",
                "example": "Write comprehensive documentation for the API"
              },
              "completed": {
                "type": "boolean",
                "description": "Whether the task is completed",
                "default": false,
                "example": false
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "The timestamp when the task was created",
                "example": "2024-01-15T10:30:00Z"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "description": "The timestamp when the task was last updated",
                "example": "2024-01-15T11:45:00Z"
              }
            }
          }
        },
        {
          "id": "updateTask",
          "method": "PUT",
          "kind": "update",
          "path": "/api/tasks/{id}",
          "identifierParam": "id",
          "requestSchema": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "The title of the task",
                "example": "Updated project documentation"
              },
              "description": {
                "type": "string",
                "description": "The description of the task",
                "example": "Write comprehensive documentation for the API with examples"
              },
              "completed": {
                "type": "boolean",
                "description": "Whether the task is completed",
                "example": true
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "_id": {
                "type": "string",
                "description": "The unique identifier for the task",
                "example": "507f1f77bcf86cd799439011"
              },
              "title": {
                "type": "string",
                "description": "The title of the task",
                "example": "Complete project documentation"
              },
              "description": {
                "type": "string",
                "description": "The description of the task",
                "example": "Write comprehensive documentation for the API"
              },
              "completed": {
                "type": "boolean",
                "description": "Whether the task is completed",
                "default": false,
                "example": false
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "The timestamp when the task was created",
                "example": "2024-01-15T10:30:00Z"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "description": "The timestamp when the task was last updated",
                "example": "2024-01-15T11:45:00Z"
              }
            }
          }
        },
        {
          "id": "deleteTask",
          "method": "DELETE",
          "kind": "delete",
          "path": "/api/tasks/{id}",
          "identifierParam": "id",
          "responseSchema": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "example": "Task deleted"
              }
            }
          }
        }
      ]
    }
  ]
}