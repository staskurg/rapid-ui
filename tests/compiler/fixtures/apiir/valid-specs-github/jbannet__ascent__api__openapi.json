    {
      "name": "User",
      "key": "user",
      "operations": [
        {
          "id": "loginUser",
          "method": "POST",
          "kind": "create",
          "path": "/api/user/login",
          "parameters": [],
          "requestSchema": {
            "type": "object",
            "required": [
              "email",
              "password"
            ],
            "properties": {
              "email": {
                "type": "string",
                "format": "email"
              },
              "password": {
                "type": "string"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "required": [
              "token",
              "user"
            ],
            "properties": {
              "token": {
                "type": "string"
              },
              "user": {
                "type": "object",
                "required": [
                  "id",
                  "email",
                  "created_at",
                  "updated_at"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "created_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "updated_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        {
          "id": "registerUser",
          "method": "POST",
          "kind": "create",
          "path": "/api/user/register",
          "parameters": [],
          "requestSchema": {
            "type": "object",
            "required": [
              "email",
              "password"
            ],
            "properties": {
              "email": {
                "type": "string",
                "format": "email"
              },
              "password": {
                "type": "string",
                "minLength": 8
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "required": [
              "id",
              "email",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    }
