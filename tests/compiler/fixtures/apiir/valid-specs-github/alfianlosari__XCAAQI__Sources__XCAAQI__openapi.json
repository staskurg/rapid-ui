{
  "apiIrVersion": 1,
  "api": {
    "title": "Google Air Quality",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Currentconditions:lookup",
      "key": "currentconditionslookup",
      "operations": [
        {
          "id": "currentConditions",
          "method": "POST",
          "kind": "create",
          "path": "/v1/currentConditions:lookup",
          "parameters": [
            {
              "in": "query",
              "name": "key",
              "schema": {
                "type": "string",
                "example": "a313"
              }
            }
          ],
          "queryParamCount": 1,
          "requestSchema": {
            "type": "object",
            "properties": {
              "location": {
                "type": "object",
                "properties": {
                  "latitude": {
                    "type": "number",
                    "example": 37.419734
                  },
                  "longitude": {
                    "type": "number",
                    "example": -122.0827784
                  }
                }
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "dateTime": {
                "type": "string",
                "example": "2023-09-27T15:00:00Z"
              },
              "indexes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "aqi": {
                      "type": "number",
                      "example": 68
                    },
                    "aqiDisplay": {
                      "type": "string",
                      "example": "68"
                    },
                    "category": {
                      "type": "string",
                      "example": "Good air quality"
                    },
                    "code": {
                      "type": "string",
                      "example": "uaqi"
                    },
                    "color": {
                      "type": "object",
                      "properties": {
                        "blue": {
                          "type": "number",
                          "example": 0.1764706
                        },
                        "green": {
                          "type": "number",
                          "example": 0.827451
                        },
                        "red": {
                          "type": "number",
                          "example": 0.5647059
                        }
                      }
                    },
                    "displayName": {
                      "type": "string",
                      "example": "Universal AQI"
                    },
                    "dominantPollutant": {
                      "type": "string",
                      "example": "pm10"
                    }
                  }
                },
                "example": [
                  {
                    "aqi": 68,
                    "aqiDisplay": "68",
                    "category": "Good air quality",
                    "code": "uaqi",
                    "color": {
                      "blue": 0.1764706,
                      "green": 0.827451,
                      "red": 0.5647059
                    },
                    "displayName": "Universal AQI",
                    "dominantPollutant": "pm10"
                  }
                ]
              },
              "regionCode": {
                "type": "string",
                "example": "us"
              }
            }
          }
        }
      ]
    }
  ]
}