{
  "apiIrVersion": 1,
  "api": {
    "title": "Policy Compliance Governor Agent API",
    "version": "0.3.3"
  },
  "resources": [
    {
      "name": "audit",
      "key": "audit",
      "operations": [
        {
          "id": "generateAuditReport",
          "method": "POST",
          "kind": "create",
          "path": "/audit/generate",
          "parameters": [],
          "requestSchema": {
            "type": "object",
            "required": [
              "period"
            ],
            "properties": {
              "period": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "format": {
                "type": "string",
                "enum": [
                  "json",
                  "pdf",
                  "html"
                ],
                "default": "json"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "report_id": {
                "type": "string"
              },
              "report_url": {
                "type": "string",
                "format": "uri"
              },
              "summary": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    {
      "name": "compliance",
      "key": "compliance",
      "operations": [
        {
          "id": "validateCompliance",
          "method": "POST",
          "kind": "create",
          "path": "/compliance/validate",
          "parameters": [],
          "requestSchema": {
            "type": "object",
            "required": [
              "framework",
              "resource"
            ],
            "properties": {
              "framework": {
                "type": "string",
                "enum": [
                  "soc2",
                  "pci-dss",
                  "gdpr",
                  "hipaa",
                  "iso27001"
                ]
              },
              "resource": {
                "type": "object"
              },
              "controls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "compliant": {
                "type": "boolean"
              },
              "violations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "control": {
                      "type": "string"
                    },
                    "severity": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              },
              "score": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    {
      "name": "policies",
      "key": "policies",
      "operations": [
        {
          "id": "enforcePolicy",
          "method": "POST",
          "kind": "create",
          "path": "/policies/enforce",
          "parameters": [],
          "requestSchema": {
            "type": "object",
            "required": [
              "policy",
              "resource"
            ],
            "properties": {
              "policy": {
                "type": "string",
                "description": "Policy identifier"
              },
              "resource": {
                "type": "object",
                "description": "Resource to enforce policy on"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "advisory",
                  "blocking",
                  "logging"
                ],
                "default": "blocking"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "allowed": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              },
              "violations": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    }
  ]
}