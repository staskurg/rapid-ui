{
  "apiIrVersion": 1,
  "api": {
    "title": "Secure Flask User API",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Health",
      "key": "health",
      "operations": [
        {
          "id": "GET:/health",
          "method": "GET",
          "kind": "list",
          "path": "/health",
          "parameters": [],
          "responseSchema": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "example": "healthy"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "key": "users",
      "operations": [
        {
          "id": "GET:/users/{user_id}",
          "method": "GET",
          "kind": "detail",
          "path": "/users/{user_id}",
          "parameters": [
            {
              "in": "path",
              "name": "user_id",
              "schema": {
                "type": "integer",
                "minimum": 1
              }
            }
          ],
          "identifierParam": "user_id",
          "responseSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "description": "User ID"
              },
              "name": {
                "type": "string",
                "description": "User name"
              }
            }
          }
        },
        {
          "id": "POST:/users",
          "method": "POST",
          "kind": "create",
          "path": "/users",
          "parameters": [],
          "requestSchema": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "example": "John Doe"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "description": "User ID"
              },
              "name": {
                "type": "string",
                "description": "User name"
              }
            }
          }
        }
      ]
    }
  ]
}