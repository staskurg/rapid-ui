{
  "api": {
    "title": "GPT Calendar Plugin",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Create_event",
      "key": "createevent",
      "operations": [
        {
          "id": "createEvent",
          "method": "POST",
          "kind": "create",
          "path": "/create_event",
          "requestSchema": {
            "type": "object",
            "required": [
              "summary",
              "start",
              "end"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "description": "Event title",
                "example": "Lunch with Sarah"
              },
              "description": {
                "type": "string",
                "description": "Event description",
                "example": "Catching up"
              },
              "location": {
                "type": "string",
                "description": "Event location",
                "example": "Downtown Cafe"
              },
              "start": {
                "type": "object",
                "required": [
                  "dateTime",
                  "timeZone"
                ],
                "properties": {
                  "dateTime": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Date and time in ISO format (without timezone suffix)",
                    "example": "2025-07-26T12:00:00"
                  },
                  "timeZone": {
                    "type": "string",
                    "description": "Timezone identifier",
                    "example": "Australia/Sydney"
                  }
                }
              },
              "end": {
                "type": "object",
                "required": [
                  "dateTime",
                  "timeZone"
                ],
                "properties": {
                  "dateTime": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Date and time in ISO format (without timezone suffix)",
                    "example": "2025-07-26T12:00:00"
                  },
                  "timeZone": {
                    "type": "string",
                    "description": "Timezone identifier",
                    "example": "Australia/Sydney"
                  }
                }
              },
              "recurrence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "RRULE:FREQ=WEEKLY;BYDAY=FR"
                ]
              },
              "reminders": {
                "type": "object",
                "properties": {
                  "useDefault": {
                    "type": "boolean",
                    "description": "Whether to use default reminders",
                    "example": false
                  },
                  "overrides": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "method",
                        "minutes"
                      ],
                      "properties": {
                        "method": {
                          "type": "string",
                          "enum": [
                            "popup",
                            "email"
                          ],
                          "description": "Reminder method",
                          "example": "popup"
                        },
                        "minutes": {
                          "type": "integer",
                          "description": "Minutes before event to remind",
                          "example": 10
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "example": "created"
              },
              "event_id": {
                "type": "string",
                "example": "abc123xyz"
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": false,
        "detail": false,
        "create": true,
        "update": false,
        "delete": false
      }
    },
    {
      "name": "Delete_event",
      "key": "deleteevent",
      "operations": [
        {
          "id": "deleteEvent",
          "method": "POST",
          "kind": "create",
          "path": "/delete_event",
          "requestSchema": {
            "type": "object",
            "required": [
              "eventId"
            ],
            "properties": {
              "eventId": {
                "type": "string",
                "description": "The ID of the event to delete",
                "example": "abc123xyz"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "example": "deleted"
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": false,
        "detail": false,
        "create": true,
        "update": false,
        "delete": false
      }
    },
    {
      "name": "Query_events",
      "key": "queryevents",
      "operations": [
        {
          "id": "queryEvents",
          "method": "POST",
          "kind": "create",
          "path": "/query_events",
          "requestSchema": {
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date",
                "description": "Start date in YYYY-MM-DD format",
                "example": "2025-07-31"
              },
              "end": {
                "type": "string",
                "format": "date",
                "description": "End date in YYYY-MM-DD format",
                "example": "2025-08-07"
              }
            }
          },
          "responseSchema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "example": "Meeting with team"
                },
                "start": {
                  "type": "object",
                  "required": [
                    "dateTime",
                    "timeZone"
                  ],
                  "properties": {
                    "dateTime": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Date and time in ISO format (without timezone suffix)",
                      "example": "2025-07-26T12:00:00"
                    },
                    "timeZone": {
                      "type": "string",
                      "description": "Timezone identifier",
                      "example": "Australia/Sydney"
                    }
                  }
                },
                "end": {
                  "type": "object",
                  "required": [
                    "dateTime",
                    "timeZone"
                  ],
                  "properties": {
                    "dateTime": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Date and time in ISO format (without timezone suffix)",
                      "example": "2025-07-26T12:00:00"
                    },
                    "timeZone": {
                      "type": "string",
                      "description": "Timezone identifier",
                      "example": "Australia/Sydney"
                    }
                  }
                },
                "eventId": {
                  "type": "string",
                  "example": "abc123xyz"
                }
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": false,
        "detail": false,
        "create": true,
        "update": false,
        "delete": false
      }
    },
