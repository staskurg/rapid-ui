{
  "api": {
    "title": "Auth",
    "version": "v1"
  },
  "resources": [
    {
      "name": "Authentication",
      "key": "authentication",
      "operations": [
        {
          "id": "POST:/authentication",
          "method": "POST",
          "kind": "create",
          "path": "/authentication",
          "requestSchema": {
            "type": "object",
            "required": [
              "username",
              "password"
            ],
            "properties": {
              "username": {
                "type": "string",
                "example": "toto@gmail.com"
              },
              "password": {
                "type": "string",
                "example": "vivegraphql"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "format": "jwt"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Verify",
      "key": "verify",
      "operations": [
        {
          "id": "POST:/verify",
          "method": "POST",
          "kind": "create",
          "path": "/verify",
          "requestSchema": {
            "type": "object",
            "required": [
              "token"
            ],
            "properties": {
              "token": {
                "type": "string",
                "format": "jwt",
                "example": "xxxxx"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "format": "jwt"
              }
            }
          }
        }
      ]
    }
  ]
}