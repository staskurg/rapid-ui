{
  "api": {
    "title": "DHOS Trustomer API",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "monitoring",
      "key": "monitoring",
      "operations": [
        {
          "id": "flask_batteries_included.blueprint_monitoring.app_running",
          "method": "GET",
          "kind": "list",
          "path": "/running",
          "responseSchema": {
            "type": "object",
            "properties": {
              "running": {
                "type": "boolean",
                "example": true
              }
            }
          }
        },
        {
          "id": "flask_batteries_included.blueprint_monitoring.app_version",
          "method": "GET",
          "kind": "list",
          "path": "/version",
          "responseSchema": {
            "type": "object",
            "properties": {
              "circle": {
                "type": "string",
                "example": "1234"
              },
              "hash": {
                "type": "string",
                "example": "366c204"
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": true,
        "detail": false,
        "create": false,
        "update": false,
        "delete": false
      }
    },
    {
      "name": "trustomer",
      "key": "trustomer",
      "operations": [
        {
          "id": "dhos_trustomer_api.blueprint_api.get_trustomer_config",
          "method": "GET",
          "kind": "list",
          "path": "/dhos/v1/trustomer",
          "responseSchema": {
            "type": "object",
            "properties": {
              "gdm_config": {
                "type": "object"
              },
              "send_config": {
                "type": "object"
              },
              "gdm_clinician_terms_content": {
                "type": "string",
                "description": "Clinician terms of use (HTML)",
                "example": "Lorem ipsum"
              },
              "gdm_clinician_terms_version": {
                "type": "string",
                "description": "Version number of clinician terms of use",
                "example": "1"
              },
              "gdm_terms_content": {
                "type": "string",
                "description": "Patient terms of use (HTML)",
                "example": "Lorem ipsum"
              },
              "gdm_terms_version": {
                "type": "string",
                "description": "Version number of patient terms of use",
                "example": "1"
              },
              "hl7_config": {
                "type": "object"
              },
              "measurement_system": {
                "type": "string",
                "description": "System of measurement",
                "example": "metric"
              },
              "created": {
                "type": "string",
                "format": "date-time",
                "description": "Record creation date/time",
                "example": "2017-09-23T08:29:19.123+00:00"
              },
              "gdm_phone_midwife": {
                "type": "string",
                "description": "Midwife telephone number",
                "example": "07777777777"
              },
              "gdm_phone_ward": {
                "type": "string",
                "description": "Ward telephone number",
                "example": "01276777777"
              },
              "modified": {
                "type": "string",
                "format": "date-time",
                "description": "Record modification date/time",
                "example": "2017-09-23T08:29:19.123+00:00"
              },
              "name": {
                "type": "string",
                "description": "Trust description",
                "example": "Forest NHS Foundation Trust"
              },
              "uuid": {
                "type": "string",
                "description": "UUID of the Trustomer configuration record",
                "example": "2c4f1d24-2952-4d4e-b1d1-3637e33cc161"
              }
            },
            "required": [
              "created",
              "gdm_clinician_terms_content",
              "gdm_clinician_terms_version",
              "gdm_config",
              "gdm_phone_midwife",
              "gdm_phone_ward",
              "gdm_terms_content",
              "gdm_terms_version",
              "hl7_config",
              "measurement_system",
              "modified",
              "name",
              "send_config",
              "uuid"
            ],
            "title": "Trustomer details",
            "additionalProperties": true
          }
        },
        {
          "id": "dhos_trustomer_api.blueprint_api.get_escalation_policy_content",
          "method": "GET",
          "kind": "detail",
          "path": "/dhos/v1/escalation_policy/{policy_name}",
          "identifierParam": "policy_name",
          "responseSchema": {
            "type": "object",
            "properties": {
              "routine_monitoring": {
                "type": "string",
                "description": "Routine monitoring instructions",
                "example": "Do something"
              },
              "low_monitoring": {
                "type": "string",
                "description": "Low monitoring instructions",
                "example": "Do something"
              },
              "low_medium_monitoring": {
                "type": "string",
                "description": "Low medium monitoring instructions",
                "example": "Do something"
              },
              "medium_monitoring": {
                "type": "string",
                "description": "Medium monitoring instructions",
                "example": "Do something"
              },
              "high_monitoring": {
                "type": "string",
                "description": "High monitoring instructions",
                "example": "Do something"
              }
            },
            "title": "Trustomer escalation policy",
            "additionalProperties": true
          }
        },
        {
          "id": "dhos_trustomer_api.blueprint_api.get_trustomer_config_by_code",
          "method": "GET",
          "kind": "detail",
          "path": "/dhos/v1/trustomer/{customer_code}",
          "identifierParam": "customer_code",
          "responseSchema": {
            "type": "object",
            "properties": {
              "gdm_config": {
                "type": "object"
              },
              "send_config": {
                "type": "object"
              },
              "gdm_clinician_terms_content": {
                "type": "string",
                "description": "Clinician terms of use (HTML)",
                "example": "Lorem ipsum"
              },
              "gdm_clinician_terms_version": {
                "type": "string",
                "description": "Version number of clinician terms of use",
                "example": "1"
              },
              "gdm_terms_content": {
                "type": "string",
                "description": "Patient terms of use (HTML)",
                "example": "Lorem ipsum"
              },
              "gdm_terms_version": {
                "type": "string",
                "description": "Version number of patient terms of use",
                "example": "1"
              },
              "hl7_config": {
                "type": "object"
              },
              "measurement_system": {
                "type": "string",
                "description": "System of measurement",
                "example": "metric"
              },
              "created": {
                "type": "string",
                "format": "date-time",
                "description": "Record creation date/time",
                "example": "2017-09-23T08:29:19.123+00:00"
              },
              "gdm_phone_midwife": {
                "type": "string",
                "description": "Midwife telephone number",
                "example": "07777777777"
              },
              "gdm_phone_ward": {
                "type": "string",
                "description": "Ward telephone number",
                "example": "01276777777"
              },
              "modified": {
                "type": "string",
                "format": "date-time",
                "description": "Record modification date/time",
                "example": "2017-09-23T08:29:19.123+00:00"
              },
              "name": {
                "type": "string",
                "description": "Trust description",
                "example": "Forest NHS Foundation Trust"
              },
              "uuid": {
                "type": "string",
                "description": "UUID of the Trustomer configuration record",
                "example": "2c4f1d24-2952-4d4e-b1d1-3637e33cc161"
              }
            },
            "required": [
              "created",
              "gdm_clinician_terms_content",
              "gdm_clinician_terms_version",
              "gdm_config",
              "gdm_phone_midwife",
              "gdm_phone_ward",
              "gdm_terms_content",
              "gdm_terms_version",
              "hl7_config",
              "measurement_system",
              "modified",
              "name",
              "send_config",
              "uuid"
            ],
            "title": "Trustomer details",
            "additionalProperties": true
          }
        },
        {
          "id": "dhos_trustomer_api.blueprint_api.parse_patient_barcode",
          "method": "POST",
          "kind": "create",
          "path": "/dhos/v1/parse_patient_barcode",
          "requestSchema": {
            "type": "object",
            "properties": {
              "barcode": {
                "type": "string",
                "description": "Patient barcode",
                "example": "12345"
              }
            },
            "required": [
              "barcode"
            ],
            "title": "Patient barcode format",
            "additionalProperties": true
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "firstname": {
                "type": "string",
                "description": "Patient's first name",
                "example": "John"
              },
              "lastname": {
                "type": "string",
                "description": "Patient's last name",
                "example": "Smith"
              },
              "sex": {
                "type": "string",
                "description": "Patient's sex",
                "example": "M",
                "enum": [
                  "M",
                  "F",
                  "U"
                ]
              },
              "nhs": {
                "type": "string",
                "description": "Patient's NHS Number",
                "example": "111222333"
              },
              "mrn": {
                "type": "string",
                "description": "Patient's Medical Record Number",
                "example": "111222333"
              }
            },
            "title": "Parsed patient barcode",
            "additionalProperties": true
          }
        }
      ],
      "capabilities": {
        "list": true,
        "detail": true,
        "create": true,
        "update": false,
        "delete": false
      }
    }
  ]
}