{
  "api": {
    "title": "User Authentication API",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Login",
      "key": "login",
      "operations": [
        {
          "id": "POST:/login",
          "method": "POST",
          "kind": "create",
          "path": "/login",
          "requestSchema": {
            "type": "object",
            "required": [
              "username",
              "password"
            ],
            "properties": {
              "username": {
                "type": "string",
                "example": "johndoe"
              },
              "password": {
                "type": "string",
                "format": "password",
                "example": "Pa$$w0rd!"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": false,
        "detail": false,
        "create": true,
        "update": false,
        "delete": false
      },
      "identityFields": []
    },
    {
      "name": "Translate-token",
      "key": "translate-token",
      "operations": [
        {
          "id": "POST:/translate-token",
          "method": "POST",
          "kind": "create",
          "path": "/translate-token",
          "requestSchema": {
            "type": "object",
            "required": [
              "token"
            ],
            "properties": {
              "token": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": false,
        "detail": false,
        "create": true,
        "update": false,
        "delete": false
      },
      "identityFields": []
    },
    {
      "name": "Users",
      "key": "users",
      "operations": [
        {
          "id": "POST:/users",
          "method": "POST",
          "kind": "create",
          "path": "/users",
          "requestSchema": {
            "type": "object",
            "required": [
              "username",
              "email",
              "password"
            ],
            "properties": {
              "username": {
                "type": "string",
                "example": "johndoe"
              },
              "email": {
                "type": "string",
                "format": "email",
                "example": "johndoe@example.com"
              },
              "password": {
                "type": "string",
                "format": "password",
                "example": "Pa$$w0rd!"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The unique ID of the created user",
                "example": 12345
              },
              "username": {
                "type": "string",
                "description": "The username of the created user",
                "example": "johndoe"
              },
              "email": {
                "type": "string",
                "format": "email",
                "description": "The email address of the created user",
                "example": "johndoe@example.com"
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": false,
        "detail": false,
        "create": true,
        "update": false,
        "delete": false
      },
      "identityFields": []
    }
  ]
}