{
  "api": {
    "title": "Ajumapro News API",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Analytics",
      "key": "analytics",
      "operations": [
        {
          "id": "GET:/analytics/performance",
          "method": "GET",
          "kind": "list",
          "path": "/analytics/performance",
          "responseSchema": {
            "type": "object",
            "properties": {
              "monthlyUsage": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "requests": {
                      "type": "integer"
                    }
                  }
                }
              },
              "avgResponseTime": {
                "type": "integer"
              },
              "cacheHitRate": {
                "type": "integer"
              }
            }
          }
        },
        {
          "id": "GET:/analytics/usage",
          "method": "GET",
          "kind": "list",
          "path": "/analytics/usage",
          "responseSchema": {
            "type": "object",
            "properties": {
              "totalRequests": {
                "type": "integer",
                "description": "Total number of API requests"
              },
              "totalArticles": {
                "type": "integer",
                "description": "Total number of articles served"
              },
              "avgResponseTime": {
                "type": "integer",
                "description": "Average response time in milliseconds"
              },
              "cacheHitRate": {
                "type": "integer",
                "description": "Cache hit rate percentage"
              },
              "monthlyUsage": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Month name"
                    },
                    "requests": {
                      "type": "integer",
                      "description": "Number of requests in the month"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": true,
        "detail": false,
        "create": false,
        "update": false,
        "delete": false
      },
      "identityFields": []
    },
    {
      "name": "News",
      "key": "news",
      "operations": [
        {
          "id": "GET:/news",
          "method": "GET",
          "kind": "list",
          "path": "/news",
          "queryParamCount": 5,
          "responseSchema": {
            "type": "object",
            "properties": {
              "articles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "Unique identifier for the article"
                    },
                    "title": {
                      "type": "string",
                      "description": "Title of the article"
                    },
                    "description": {
                      "type": "string",
                      "description": "Brief description of the article"
                    },
                    "category": {
                      "type": "string",
                      "description": "Category of the article (e.g., Business, Technology)"
                    },
                    "source": {
                      "type": "string",
                      "description": "Source of the article"
                    },
                    "imageUrl": {
                      "type": "string",
                      "description": "URL of the article's image"
                    },
                    "date": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Publication date of the article"
                    }
                  }
                }
              },
              "total": {
                "type": "integer"
              },
              "page": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": true,
        "detail": false,
        "create": false,
        "update": false,
        "delete": false
      },
      "identityFields": []
    }
  ]
}