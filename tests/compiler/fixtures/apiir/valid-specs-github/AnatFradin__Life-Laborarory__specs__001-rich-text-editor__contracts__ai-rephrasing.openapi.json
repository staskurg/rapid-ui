{
  "api": {
    "title": "AI Rephrasing API",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "AI",
      "key": "ai",
      "operations": [
        {
          "id": "rephraseText",
          "method": "POST",
          "kind": "create",
          "path": "/api/ai/rephrase",
          "requestSchema": {
            "type": "object",
            "required": [
              "originalText",
              "style",
              "aiProvider",
              "model"
            ],
            "properties": {
              "originalText": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000,
                "description": "The text user wants rephrased",
                "example": "I struggled with this task today."
              },
              "style": {
                "type": "string",
                "enum": [
                  "clearer",
                  "more-positive",
                  "more-constructive"
                ],
                "description": "Rephrasing style:\n- `clearer`: Simplify complex language, use shorter sentences\n- `more-positive`: Reframe negative tone constructively\n- `more-constructive`: Focus on growth and learning\n",
                "example": "more-positive"
              },
              "context": {
                "type": "object",
                "description": "Optional surrounding text for better AI context",
                "properties": {
                  "before": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Up to 200 characters before the selected text",
                    "example": "Reflecting on my day."
                  },
                  "after": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Up to 200 characters after the selected text",
                    "example": "I'll try a different approach tomorrow."
                  }
                }
              },
              "aiProvider": {
                "type": "string",
                "enum": [
                  "ollama",
                  "openai",
                  "anthropic"
                ],
                "description": "AI service to use (must match user's preference)",
                "example": "ollama"
              },
              "model": {
                "type": "string",
                "description": "Model name (must be available for selected provider)",
                "example": "llama3"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "required": [
              "originalText",
              "suggestions",
              "style",
              "timestamp",
              "tokenCount"
            ],
            "properties": {
              "originalText": {
                "type": "string",
                "description": "Echo of the user's selected text",
                "example": "I struggled with this task today."
              },
              "suggestions": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "description": "2-3 alternative phrasings from AI",
                "example": [
                  "This task was challenging today, and I learned from it.",
                  "I found this task difficult today, which helped me understand what I need to practice."
                ]
              },
              "style": {
                "type": "string",
                "enum": [
                  "clearer",
                  "more-positive",
                  "more-constructive"
                ],
                "description": "The rephrasing style that was applied",
                "example": "more-positive"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "When the suggestions were generated",
                "example": "2025-11-27T14:30:00Z"
              },
              "tokenCount": {
                "type": "integer",
                "minimum": 0,
                "description": "Token count for API usage tracking (if applicable)",
                "example": 42
              }
            }
          }
        }
      ]
    }
  ]
}