                "type": "string",
                "format": "date-time",
                "description": "Task creation time"
              },
              "started_at": {
                "type": "string",
                "format": "date-time",
                "description": "Task start execution time",
                "nullable": true
              },
              "completed_at": {
                "type": "string",
                "format": "date-time",
                "description": "Task completion time",
                "nullable": true
              },
              "result": {
                "type": "object",
                "description": "Task execution result",
                "additionalProperties": true,
                "nullable": true
              },
              "error": {
                "type": "string",
                "description": "Error message (if task failed)",
