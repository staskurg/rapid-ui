      "name": "Autenticación",
      "key": "autenticacin",
      "operations": [
        {
          "id": "loginUser",
          "method": "POST",
          "kind": "create",
          "path": "/api/user/login",
          "requestSchema": {
            "type": "object",
            "required": [
              "email",
              "password"
            ],
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "example": "test.user@example.com"
              },
              "password": {
                "type": "string",
                "format": "password",
                "example": "password123"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "example": "Bienvenido test.user@example.com"
              },
              "user": {
                "type": "string",
                "example": "test.user@example.com"
              },
              "role": {
                "type": "string",
                "example": "authenticated"
              },
              "token": {
                "type": "string",
                "description": "Token JWT para autenticar peticiones posteriores."
              }
            }
          }
        },
        {
          "id": "signupUser",
          "method": "POST",
          "kind": "create",
          "path": "/api/user/signup",
          "requestSchema": {
            "type": "object",
            "required": [
              "email",
              "password"
            ],
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "example": "test.user@example.com"
              },
              "password": {
                "type": "string",
                "format": "password",
                "example": "password123"
              }
            }
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "example": "Bienvenido test.user@example.com"
              },
              "user": {
                "type": "string",
                "example": "test.user@example.com"
              },
              "role": {
                "type": "string",
                "example": "authenticated"
              },
              "token": {
                "type": "string",
                "description": "Token JWT para autenticar peticiones posteriores."
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": false,
        "detail": false,
        "create": true,
        "update": false,
        "delete": false
