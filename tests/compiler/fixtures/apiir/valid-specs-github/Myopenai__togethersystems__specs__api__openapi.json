{
  "api": {
    "title": "Fabrikage API - Live Mirror Architecture",
    "version": "3.0.0"
  },
  "resources": [
    {
      "name": "Energy-ledger",
      "key": "energy-ledger",
      "operations": [
        {
          "id": "getEnergyLedger",
          "method": "GET",
          "kind": "list",
          "path": "/api/energy-ledger",
          "responseSchema": {
            "type": "object",
            "required": [
              "sources",
              "sinks",
              "balance",
              "efficiency"
            ],
            "properties": {
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "mw",
                    "level"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "mw": {
                      "type": "number"
                    },
                    "level": {
                      "type": "string"
                    }
                  }
                }
              },
              "sinks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "mw",
                    "level"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "mw": {
                      "type": "number"
                    },
                    "level": {
                      "type": "string"
                    }
                  }
                }
              },
              "balance": {
                "type": "number"
              },
              "efficiency": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": true,
        "detail": false,
        "create": false,
        "update": false,
        "delete": false
      }
    },
