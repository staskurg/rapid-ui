                    "sense",
                    "commit",
                    "transform",
                    "emerge"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "signature": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      ],
      "capabilities": {
        "list": true,
        "detail": false,
