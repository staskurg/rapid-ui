{
  "apiIrVersion": 1,
  "api": {
    "title": "Stellastra",
    "version": "1.0"
  },
  "resources": [
    {
      "name": "Post-review",
      "key": "post-review",
      "operations": [
        {
          "id": "POST:/post-review",
          "method": "POST",
          "kind": "create",
          "path": "/post-review",
          "parameters": [
            {
              "in": "query",
              "name": "rating",
              "schema": {
                "enum": [
                  1,
                  2,
                  3,
                  4,
                  5
                ],
                "type": "integer"
              },
              "required": true
            },
            {
              "in": "query",
              "name": "user_email",
              "schema": {
                "description": "User's email must exist and must not use a professional domain (I.E., not from a free service).",
                "type": "string"
              },
              "required": true
            },
            {
              "in": "query",
              "name": "user_name",
              "schema": {
                "type": "string"
              }
            }
          ],
          "queryParamCount": 3,
          "requestSchema": {
            "description": "The user_email must use a professional domain, free domains are not supported. ",
            "properties": {
              "rating": {
                "example": 5,
                "type": "integer"
              },
              "user_email": {
                "example": "johnsmith@usercompanyxyz.com",
                "type": "string"
              },
              "user_name": {
                "example": "John",
                "type": "string"
              }
            },
            "required": [
              "user_email",
              "rating"
            ],
            "type": "object"
          },
          "responseSchema": {
            "description": "",
            "example": {
              "data": "Review posted successfully"
            },
            "properties": {
              "data": {
                "example": "Review posted successfully",
                "type": "string"
              }
            },
            "type": "object"
          }
        }
      ]
    }
  ]
}