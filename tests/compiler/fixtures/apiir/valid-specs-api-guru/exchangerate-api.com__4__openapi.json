{
  "api": {
    "title": "ExchangeRate-API",
    "version": "4"
  },
  "resources": [
    {
      "name": "Latest",
      "key": "latest",
      "operations": [
        {
          "id": "GET:/latest/{base_currency}",
          "method": "GET",
          "kind": "detail",
          "path": "/latest/{base_currency}",
          "identifierParam": "base_currency",
          "responseSchema": {
            "properties": {
              "base": {
                "description": "The currency code you supplied as base in your request",
                "example": "USD",
                "type": "string"
              },
              "date": {
                "description": "The date these exchange rates are for",
                "type": "string"
              },
              "rates": {
                "additionalProperties": {
                  "format": "double",
                  "type": "number"
                },
                "description": "Each supported currency code in terms of the base currency",
                "type": "object"
              },
              "time_last_updated": {
                "description": "The epoch time this set of exchange rates was generated",
                "example": 1556293443,
                "type": "integer"
              }
            },
            "type": "object"
          }
        }
      ],
      "capabilities": {
        "list": false,
        "detail": true,
        "create": false,
        "update": false,
        "delete": false
      },
      "identityFields": [
        "base_currency"
      ]
    }
  ]
}