{
  "apiIrVersion": 1,
  "api": {
    "title": "Search Services",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Search",
      "key": "search",
      "operations": [
        {
          "id": "GET:/search/v1/fields",
          "method": "GET",
          "kind": "list",
          "path": "/search/v1/fields",
          "parameters": [
            {
              "in": "query",
              "name": "callback",
              "schema": {
                "type": "string"
              }
            }
          ],
          "queryParamCount": 1,
          "responseSchema": {
            "items": {
              "description": "The name of a field",
              "type": "string"
            },
            "type": "array"
          }
        },
        {
          "id": "GET:/search/v1/organic",
          "method": "GET",
          "kind": "list",
          "path": "/search/v1/organic",
          "parameters": [
            {
              "in": "query",
              "name": "callback",
              "schema": {
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "field",
              "schema": {
                "default": "identifier",
                "maxLength": 250,
                "minLength": 1,
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "q",
              "schema": {
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "size",
              "schema": {
                "default": 1000,
                "maximum": 10000,
                "minimum": 10,
                "type": "integer"
              }
            },
            {
              "in": "query",
              "name": "total_only",
              "schema": {
                "default": false,
                "type": "boolean"
              }
            }
          ],
          "queryParamCount": 5,
          "responseSchema": {
            "description": "The result of a organic search request",
            "properties": {
              "count": {
                "description": "Number of results returned",
                "maximum": 10000,
                "minimum": 0,
                "type": "integer"
              },
              "items": {
                "items": {
                  "description": "One item returned (object of fields and values)",
                  "type": "object"
                },
                "type": "array"
              },
              "total": {
                "description": "Approximate number of results meeting query",
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        {
          "id": "GET:/search/v1/scrape",
          "method": "GET",
          "kind": "list",
          "path": "/search/v1/scrape",
          "parameters": [
            {
              "in": "query",
              "name": "callback",
              "schema": {
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "cursor",
              "schema": {
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "field",
              "schema": {
                "default": "identifier",
                "maxLength": 250,
                "minLength": 1,
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "q",
              "schema": {
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "size",
              "schema": {
                "default": 1000,
                "maximum": 10000,
                "minimum": 10,
                "type": "integer"
              }
            },
            {
              "in": "query",
              "name": "sort",
              "schema": {
                "maxLength": 250,
                "minLength": 5,
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "total_only",
              "schema": {
                "default": false,
                "type": "boolean"
              }
            }
          ],
          "queryParamCount": 7,
          "responseSchema": {
            "description": "The result of a scrape request",
            "properties": {
              "count": {
                "description": "Number of results returned",
                "maximum": 10000,
                "minimum": 0,
                "type": "integer"
              },
              "cursor": {
                "description": "A scroll handle",
                "type": "string"
              },
              "items": {
                "items": {
                  "description": "One item returned (object of fields and values)",
                  "type": "object"
                },
                "type": "array"
              },
              "previous": {
                "description": "A scroll handle",
                "type": "string"
              },
              "total": {
                "description": "Total number of results from this cursor point",
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          }
        }
      ]
    }
  ]
}