{
  "api": {
    "title": "Detail Update API",
    "version": "1.0.0"
  },
  "resources": [
    {
      "name": "Items",
      "key": "items",
      "operations": [
        {
          "id": "getItem",
          "method": "GET",
          "kind": "detail",
          "path": "/items/{id}",
          "identifierParam": "id",
          "responseSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        {
          "id": "updateItem",
          "method": "PATCH",
          "kind": "update",
          "path": "/items/{id}",
          "identifierParam": "id",
          "requestSchema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "active"
                ]
              }
            },
            "required": [
              "name"
            ]
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        }
      ],
      "capabilities": {
        "list": false,
        "detail": true,
        "create": false,
        "update": true,
        "delete": false
      },
      "identityFields": [
        "id"
      ]
    }
  ]
}